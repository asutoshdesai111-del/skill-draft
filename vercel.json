{
  "buildCommand": "pnpm run build:frontend && pnpm --filter @workspace/api-server run build",
  "outputDirectory": "artifacts/fresher-resume/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/*.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
