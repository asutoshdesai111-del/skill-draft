# Postgres connection string. Local Docker: postgresql://postgres:password@localhost:5432/heliumdb?sslmode=disable
DATABASE_URL=

# Random secret used to sign JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
SESSION_SECRET=

# Backend port (local dev only, unused on Vercel)
PORT=8080

# Base path the frontend is served from
BASE_PATH=/
